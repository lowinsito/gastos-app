// Esquema de la base de datos de la app de gastos compartidos.
// Cada vez que se modifica este archivo hay que crear una migracion:
//   npx prisma migrate dev --name descripcion-del-cambio

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Las dos personas de la casa.
enum Persona {
  JOSE
  CAMILA
}

/// Quien puede entrar a la app.
///
/// No hay pantalla de registro: son siempre los mismos dos y los creamos
/// nosotros con `npm run usuarios`.
model Usuario {
  id      String  @id @default(cuid())
  persona Persona @unique

  /// El hash de la contrasena, NUNCA la contrasena.
  /// Si alguien roba la base, no puede deducir las claves de aca.
  hashClave String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

/// Un item de la lista del super.
///
/// Es una tabla aparte de `Gasto` a proposito: un item no tiene monto ni
/// fecha ni categoria, y un gasto no tiene "comprado si/no". Mezclarlos
/// obligaria a dejar la mitad de las columnas vacias en cada fila.
model ItemLista {
  id     String @id @default(cuid())
  nombre String

  /// El tildecito. Los comprados NO se borran solos: quedan tachados al
  /// final de la lista hasta que alguien aprieta "Vaciar comprados".
  comprado Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // La lista siempre se pide igual: primero lo que falta comprar y, dentro
  // de cada grupo, por orden de carga. El indice esta armado con esas dos
  // columnas en ese orden para que la base no tenga que ordenar a mano.
  @@index([comprado, creadoEn])
}

/// Categorias posibles de un gasto.
enum Categoria {
  SUPERMERCADO
  SERVICIOS
  COMIDA_AFUERA
  SALUD
  OCIO
  MASCOTAS
  HOGAR
  OTROS
}

/// Un gasto del hogar. Siempre se reparte 50/50 entre Jose y Camila,
/// pero la plata puede haber salido de un solo bolsillo o de los dos.
model Gasto {
  id String @id @default(cuid())

  fecha       DateTime  @db.Date
  descripcion String
  categoria   Categoria

  /// Cuanto puso cada uno. El monto total es la suma de ambos.
  pusoJose   Decimal @default(0) @db.Decimal(12, 2)
  pusoCamila Decimal @default(0) @db.Decimal(12, 2)

  observaciones String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Indices para las consultas que la app hace seguido:
  // filtrar por mes y filtrar por categoria.
  @@index([fecha])
  @@index([categoria])
}
